JWT_SECRET=replace-with-64-random-hex-characters
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
# Number of reverse proxies between the client and this API. Express skips this
# many entries from the right of X-Forwarded-For to find the real client IP.
# 1 = only the bundled nginx container; add 1 for each proxy in front of it
# (a shared ingress, Cloudflare). Never use "true": it makes Express believe
# whatever the client writes in X-Forwarded-For, bypassing every rate limit.
TRUST_PROXY=1
BCRYPT_COST=10

# Email-based pattern reset. Leave SMTP_USER/SMTP_PASS unset to disable it
# entirely — the QR recovery key keeps working either way.
# For Gmail: enable 2FA on the account, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.aurarios@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=BloomFocus <support.aurarios@gmail.com>
RESET_TOKEN_TTL_MINUTES=45
