PORT=4000
DATABASE_PATH=./data/bloomfocus.db
# Generate with: openssl rand -hex 32
JWT_SECRET=<64-char-random-hex>
# Comma-separated origins are supported when you need local dev plus production.
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
BCRYPT_COST=10
# Local dev has no proxy in front of the API, so trust only loopback addresses.
# In production set the proxy hop count instead - see .env.example at the repo root.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Email-based pattern reset. Unset SMTP_USER/SMTP_PASS to disable it locally.
# Gmail needs an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BloomFocus <support.aurarios@gmail.com>
RESET_TOKEN_TTL_MINUTES=45
